# Local development values.
# apps/web/.env.local needs every variable below.
# packages/db/.env needs only DATABASE_URL.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://chayan:chayan@localhost:5432/chayan

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs sessions and tokens. Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-output-of-openssl-rand-base64-32

# Google login (optional locally). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Resend. Leave empty locally to print emails in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Chayan <onboarding@resend.dev>

# Optional: email address that gets a message for every new mentor application
ADMIN_NOTIFY_EMAIL=

# Private file storage on Cloudflare R2. Leave all four empty locally to store
# uploads in apps/web/.uploads instead. Required in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Razorpay (Dashboard > Account & Settings > API Keys). Leave empty locally to use
# test-mode payments that simulate success. All three are required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL <site>/api/webhooks/razorpay, events payment.captured,
# payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# Only for a staging server that runs in production mode with rzp_test_ keys
RAZORPAY_ALLOW_TEST_KEYS=

# 100ms video (dashboard.100ms.live > Developer). Leave empty locally for test calls
# that use only your own camera. Required in production.
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=
# 100ms webhook: URL <site>/api/webhooks/100ms with header x-webhook-secret: <this value>.
# When set, attendance comes only from 100ms, so it can't be faked from a browser.
HMS_WEBHOOK_SECRET=

# Protects /api/cron/tick. Required in production: openssl rand -hex 32
CRON_SECRET=

# Encrypts mentors' bank account numbers, UPI IDs and PAN. Required in production.
# Generate with: openssl rand -base64 32. Back it up: losing it makes saved details unreadable.
PAYOUT_ENCRYPTION_KEY=
