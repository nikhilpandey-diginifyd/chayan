# Local development values.
# apps/web/.env.local needs every variable below.
# packages/db/.env needs only DATABASE_URL.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://chayan:chayan@localhost:5432/chayan

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs sessions and tokens. Generate your own with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-output-of-openssl-rand-base64-32

# Google login (optional locally). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Resend. Leave empty locally to print emails in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Chayan <onboarding@resend.dev>

# Optional: email address that gets a message for every new mentor application
ADMIN_NOTIFY_EMAIL=

# Private file storage on Cloudflare R2. Leave all four empty locally to store
# uploads in apps/web/.uploads instead. Required in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
