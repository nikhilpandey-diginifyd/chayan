{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter @chayan/web e2e *)",
      "Bash(pnpm --filter @chayan/web exec vitest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(docker compose down *)",
      "Bash(pnpm add *)",
      "Bash(pnpm db:migrate)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(docker compose down -v*)"
    ]
  }
}
