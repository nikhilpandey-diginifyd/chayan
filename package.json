{
  "name": "chayan",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @chayan/db db:generate",
    "db:migrate": "pnpm --filter @chayan/db db:migrate",
    "db:seed": "pnpm --filter @chayan/db db:seed",
    "db:studio": "pnpm --filter @chayan/db db:studio",
    "db:make-admin": "pnpm --filter @chayan/db db:make-admin",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
